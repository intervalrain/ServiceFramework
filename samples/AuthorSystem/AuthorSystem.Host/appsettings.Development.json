{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Async",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.CallerInfo"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Async", 
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/authorsystem-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 7,
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{AppName}] [{Caller}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ]
  },
  "AutoConvention": {
    "RoutePrefix": "nats",
    "UseExceptionHandler": false,
    "DefaultJetStreamEnable": true,
    "EnableAuditWrapper": true
  },
  "ServiceFramework": {
    "DefaultConnection": "bus",
    "Connections": {
      "bus": {
        "Url": "nats://localhost:4223",
        "CredFile": "",
        "NatsSerializerRegistry": "json"
      },
      "broker": {
        "Url": "nats://localhost:4222",
        "CredFile": "",
        "NatsSerializerRegistry": "protobuf"
      }
    }
  }
}
