<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>EdgeSync.ServiceFramework.DependencyInjection</PackageId>
    <Version>1.0.0</Version>
    <Authors>Rain Hu, Kevin Chien</Authors>
    <Company>Advantech</Company>
    <Description>An integrated service handler implementation for NATS</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSource>true</IncludeSource>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EdgeSync.ServiceFramework.Abstractions\EdgeSync.ServiceFramework.Abstractions.csproj" />
    <ProjectReference Include="..\EdgeSync.ServiceFramework.Core\EdgeSync.ServiceFramework.Core.csproj" />
  </ItemGroup>

</Project>
